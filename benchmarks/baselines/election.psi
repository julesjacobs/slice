def main() {
    n := 4000;
    param := uniformInt(250, 349);
    p := beta(277, param);
    votes := 0;

    if p <= 0.05 {
        votes = binomial(n, 0.025);
    } else if p <= 0.1 {
        votes = binomial(n, 0.075);
    } else if p <= 0.15 {
        votes = binomial(n, 0.125);
    } else if p <= 0.2 {
        votes = binomial(n, 0.175);
    } else if p <= 0.25 {
        votes = binomial(n, 0.225);
    } else if p <= 0.3 {
        votes = binomial(n, 0.275);
    } else if p <= 0.35 {
        votes = binomial(n, 0.325);
    } else if p <= 0.4 {
        votes = binomial(n, 0.375);
    } else if p <= 0.45 {
        votes = binomial(n, 0.425);
    } else if p <= 0.5 {
        votes = binomial(n, 0.475);
    } else if p <= 0.55 {
        votes = binomial(n, 0.525);
    } else if p <= 0.6 {
        votes = binomial(n, 0.575);
    } else if p <= 0.65 {
        votes = binomial(n, 0.625);
    } else if p <= 0.7 {
        votes = binomial(n, 0.675);
    } else if p <= 0.75 {
        votes = binomial(n, 0.725);
    } else if p <= 0.8 {
        votes = binomial(n, 0.775);
    } else if p <= 0.85 {
        votes = binomial(n, 0.825);
    } else if p <= 0.9 {
        votes = binomial(n, 0.875);
    } else if p <= 0.95 {
        votes = binomial(n, 0.925);
    } else {
        votes = binomial(n, 0.975);
    }

    win := votes > 0.5 * n;
    observe(win);
    return param < 1;
}
