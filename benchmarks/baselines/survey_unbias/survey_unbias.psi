def main() {
    numPopulations := 2;
    n := 5;
    population := [1000, 2000];
    gender := [0, 1];
    personGender := [0, 1, 0, 1, 0];
    dataAnswer := [1, 0, 1, 1, 0];

    bias := array(numPopulations);
    votes := array(numPopulations);
    ansBias := array(n);
    answer := array(n);

    for i in [0..bias.length) {
        bias[i] = beta(1, 1);
    }

    for i in [0..votes.length) {
        if bias[i] <= 0.05 {
            votes[i] = binomial(population[i], 0.05);
        } else if bias[i] <= 0.1 {
            votes[i] = binomial(population[i], 0.1);
        } else if bias[i] <= 0.15 {
            votes[i] = binomial(population[i], 0.15);
        } else if bias[i] <= 0.2 {
            votes[i] = binomial(population[i], 0.2);
        } else if bias[i] <= 0.25 {
            votes[i] = binomial(population[i], 0.25);
        } else if bias[i] <= 0.3 {
            votes[i] = binomial(population[i], 0.3);
        } else if bias[i] <= 0.35 {
            votes[i] = binomial(population[i], 0.35);
        } else if bias[i] <= 0.4 {
            votes[i] = binomial(population[i], 0.4);
        } else if bias[i] <= 0.45 {
            votes[i] = binomial(population[i], 0.45);
        } else if bias[i] <= 0.5 {
            votes[i] = binomial(population[i], 0.5);
        } else if bias[i] <= 0.55 {
            votes[i] = binomial(population[i], 0.55);
        } else if bias[i] <= 0.6 {
            votes[i] = binomial(population[i], 0.6);
        } else if bias[i] <= 0.65 {
            votes[i] = binomial(population[i], 0.65);
        } else if bias[i] <= 0.7 {
            votes[i] = binomial(population[i], 0.7);
        } else if bias[i] <= 0.75 {
            votes[i] = binomial(population[i], 0.75);
        } else if bias[i] <= 0.8 {
            votes[i] = binomial(population[i], 0.8);
        } else if bias[i] <= 0.85 {
            votes[i] = binomial(population[i], 0.85);
        } else if bias[i] <= 0.9 {
            votes[i] = binomial(population[i], 0.9);
        } else if bias[i] <= 0.95 {
            votes[i] = binomial(population[i], 0.95);
        } else {
            votes[i] = binomial(population[i], 1);
        }
    }

    for i in [0..ansBias.length) {
        ansBias[i] = bias[personGender[i]];
    }

    for i in [0..answer.length) {
        if ansBias[i] <= 0.05 {
            answer[i] = bernoulli(0.05);
        } else if ansBias[i] <= 0.1 {
            answer[i] = bernoulli(0.1);
        } else if ansBias[i] <= 0.15 {
            answer[i] = bernoulli(0.15);
        } else if ansBias[i] <= 0.2 {
            answer[i] = bernoulli(0.2);
        } else if ansBias[i] <= 0.25 {
            answer[i] = bernoulli(0.25);
        } else if ansBias[i] <= 0.3 {
            answer[i] = bernoulli(0.3);
        } else if ansBias[i] <= 0.35 {
            answer[i] = bernoulli(0.35);
        } else if ansBias[i] <= 0.4 {
            answer[i] = bernoulli(0.4);
        } else if ansBias[i] <= 0.45 {
            answer[i] = bernoulli(0.45);
        } else if ansBias[i] <= 0.5 {
            answer[i] = bernoulli(0.5);
        } else if ansBias[i] <= 0.55 {
            answer[i] = bernoulli(0.55);
        } else if ansBias[i] <= 0.6 {
            answer[i] = bernoulli(0.6);
        } else if ansBias[i] <= 0.65 {
            answer[i] = bernoulli(0.65);
        } else if ansBias[i] <= 0.7 {
            answer[i] = bernoulli(0.7);
        } else if ansBias[i] <= 0.75 {
            answer[i] = bernoulli(0.75);
        } else if ansBias[i] <= 0.8 {
            answer[i] = bernoulli(0.8);
        } else if ansBias[i] <= 0.85 {
            answer[i] = bernoulli(0.85);
        } else if ansBias[i] <= 0.9 {
            answer[i] = bernoulli(0.9);
        } else if ansBias[i] <= 0.95 {
            answer[i] = bernoulli(0.95);
        } else {
            answer[i] = bernoulli(1);
        }
    }

    for i in [0..answer.length) {
        observe(answer[i] == dataAnswer[i]);
    }

    return bias[0] < 0.5;
}
