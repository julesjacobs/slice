def prob_not(p prob) prob:
    real2prob(1 - prob2real(p))

def bern(p prob):
    i <~ categorical([p, prob_not(p)])
    return [true, false][i]

def observe_bool(b bool):
    if b:
        weight(1, return ())
    else:
        weight(0, return ())

def observe_eq(actual bool, expected bool):
    if expected:
        observe_bool(actual)
    else:
        if actual:
            weight(0, return ())
        else:
            weight(1, return ())

def binom_pmf(n nat, k nat, p prob) prob:
    nat2prob(choose(n, k)) * p ** nat2real(k) *
        prob_not(p) ** (nat2real(n) - nat2real(k))

def binom(n nat, p prob):
    k <~ categorical(array i of n + 1: binom_pmf(n, i, p))
    return k

population = [1000, 2000]
gender = [0, 1]
personGender = [0, 1, 0, 1, 0]
dataAnswer = [true, false, true, true, false]

bias_0 <~ beta(1, 1)
bias_1 <~ beta(1, 1)
bias = [bias_0, bias_1]

votes_0 <~ binom(population[0], bias[0])
votes_1 <~ binom(population[1], bias[1])
votes = [votes_0, votes_1]

ansBias = array i of 5: bias[personGender[i]]

answer_0 <~ bern(ansBias[0])
answer_1 <~ bern(ansBias[1])
answer_2 <~ bern(ansBias[2])
answer_3 <~ bern(ansBias[3])
answer_4 <~ bern(ansBias[4])
answer = [answer_0, answer_1, answer_2, answer_3, answer_4]

_ <~ observe_eq(answer[0], dataAnswer[0])
_ <~ observe_eq(answer[1], dataAnswer[1])
_ <~ observe_eq(answer[2], dataAnswer[2])
_ <~ observe_eq(answer[3], dataAnswer[3])
_ <~ observe_eq(answer[4], dataAnswer[4])

return ((), bias[0] < 1/2)
