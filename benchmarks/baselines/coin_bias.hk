# Exact probability pair for the CoinBias query:
#   observed tosses = [1, 1, 0, 1, 0]
#   query = not(tossResults[0])
# Output order is (P(query = false), P(query = true)).

def beta25_mass(i nat) prob:
    lo = nat2real(i) / nat2real(10)
    hi = nat2real(i + 1) / nat2real(10)
    integrate x from lo to hi:
        nat2prob(30) * real2prob(x) * real2prob(1 - x) ** 4

def bucket_prob(i nat) prob:
    nat2prob(i + 1) / 10

evidence = summate i from 0 to 10:
    p = bucket_prob(i)
    beta25_mass(i) * p ** 3 * real2prob(1 - prob2real(p)) ** 2

(evidence / evidence, nat2prob(0))
