# Model-shaped Hakaru version of student_interviews.py.

def prob_not(p prob) prob:
    real2prob(1 - prob2real(p))

def bern(p prob):
    i <~ categorical([p, prob_not(p)])
    return [true, false][i]

def observe_bool(b bool):
    if b:
        weight(1, return ())
    else:
        weight(0, return ())

def binom_pmf(n nat, k nat, p prob) prob:
    nat2prob(choose(n, k)) * p ** nat2real(k) *
        prob_not(p) ** (nat2real(n) - nat2real(k))

def binom(n nat, p prob):
    k <~ categorical(array i of n + 1: binom_pmf(n, i, p))
    return k

def sample_gpa_unit(student_perfect bool):
    if student_perfect:
        return nat2prob(1)
    else:
        beta(7, 3)

def sample_interviews(num_recruiters nat, student_perfect bool, student_gpa_unit prob):
    if student_perfect:
        binom(num_recruiters, 0.9)
    else:
        if 7/8 < student_gpa_unit:
            binom(num_recruiters, 0.6)
        else:
            binom(num_recruiters, 0.5)

def sample_student_ignored(num_recruiters nat):
    student_perfect <~ bern(0.2)
    student_gpa_unit <~ sample_gpa_unit(student_perfect)
    student_interviews <~ sample_interviews(num_recruiters, student_perfect, student_gpa_unit)
    student_offers <~ binom(student_interviews, 0.4)
    return ()

num_recruiters <~ poisson(25)
_ <~ observe_bool(10 <= num_recruiters)
_ <~ observe_bool(num_recruiters <= 40)

student_perfect_0 <~ bern(0.2)
student_gpa_unit_0 <~ sample_gpa_unit(student_perfect_0)
student_interviews_0 <~ sample_interviews(num_recruiters, student_perfect_0, student_gpa_unit_0)
student_offers_0 <~ binom(student_interviews_0, 0.4)

_ <~ sample_student_ignored(num_recruiters)
_ <~ sample_student_ignored(num_recruiters)
_ <~ sample_student_ignored(num_recruiters)
_ <~ sample_student_ignored(num_recruiters)
_ <~ sample_student_ignored(num_recruiters)
_ <~ sample_student_ignored(num_recruiters)
_ <~ sample_student_ignored(num_recruiters)
_ <~ sample_student_ignored(num_recruiters)
_ <~ sample_student_ignored(num_recruiters)

_ <~ observe_bool(student_offers_0 == 1)
_ <~ observe_bool(10 < num_recruiters)

return student_gpa_unit_0 < 1/8
