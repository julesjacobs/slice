# Model-shaped Hakaru version of trueskill.py.

def prob_not(p prob) prob:
    real2prob(1 - prob2real(p))

def observe_bool(b bool):
    if b:
        weight(1, return ())
    else:
        weight(0, return ())

def binom_pmf(n nat, k nat, p prob) prob:
    nat2prob(choose(n, k)) * p ** nat2real(k) *
        prob_not(p) ** (nat2real(n) - nat2real(k))

def binom(n nat, p prob):
    k <~ categorical(array i of n + 1: binom_pmf(n, i, p))
    return k

perfB1 <~ binom(100, 0.9)
_ <~ observe_bool(80 <= perfB1)

skillA <~ poisson(100)
_ <~ observe_bool(77 <= skillA)
_ <~ observe_bool(skillA < 125)

perfA1 <~ binom(skillA, 0.9)
result <~ return perfA1 > perfB1
_ <~ observe_bool(not(result))

return perfA1 == 1
