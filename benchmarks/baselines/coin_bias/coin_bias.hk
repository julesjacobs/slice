# Model-shaped Hakaru version of coin_bias.py.

def prob_not(p prob) prob:
    real2prob(1 - prob2real(p))

def bern(p prob):
    i <~ categorical([p, prob_not(p)])
    return [true, false][i]

def observe_bool(b bool):
    if b:
        weight(1, return ())
    else:
        weight(0, return ())

def observe_eq(actual bool, expected bool):
    if expected:
        observe_bool(actual)
    else:
        observe_bool(not(actual))

def binspace10_right(p prob) prob:
    if p <= 1/10:
        1/10
    else:
        if p <= 2/10:
            2/10
        else:
            if p <= 3/10:
                3/10
            else:
                if p <= 4/10:
                    4/10
                else:
                    if p <= 5/10:
                        5/10
                    else:
                        if p <= 6/10:
                            6/10
                        else:
                            if p <= 7/10:
                                7/10
                            else:
                                if p <= 8/10:
                                    8/10
                                else:
                                    if p <= 9/10:
                                        9/10
                                    else:
                                        1

def observed_toss(bias prob, observed bool):
    tossResult <~ bern(binspace10_right(bias))
    _ <~ observe_eq(tossResult, observed)
    return tossResult

bias <~ beta(2, 5)

tossResults_0 <~ observed_toss(bias, true)
_ <~ observed_toss(bias, true)
_ <~ observed_toss(bias, false)
_ <~ observed_toss(bias, true)
_ <~ observed_toss(bias, false)

return not(tossResults_0)
