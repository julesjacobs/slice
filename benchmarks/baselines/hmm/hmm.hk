# Model-shaped Hakaru version of hmm.py with n = 4.

def draw_initial_z(_ignored nat):
    categorical([0.7, 0.2, 0.1])

def draw_next_z(prev nat):
    if prev == 0:
        categorical([0.7, 0.2, 0.1])
    else:
        if prev == 1:
            categorical([0.2, 0.5, 0.3])
        else:
            categorical([0.1, 0.1, 0.8])

def draw_emission(z nat):
    if z == 0:
        normal(0.5, 1)
    else:
        if z == 1:
            normal(1.0, 1)
        else:
            normal(2.0, 1)

Z_0 <~ draw_initial_z(0)
Z_1 <~ draw_next_z(Z_0)
Z_2 <~ draw_next_z(Z_1)
Z_3 <~ draw_next_z(Z_2)

Y_0 <~ draw_emission(Z_0)
Y_1 <~ draw_emission(Z_1)
Y_2 <~ draw_emission(Z_2)
Y_3 <~ draw_emission(Z_3)

return Y_3 < 0.5
