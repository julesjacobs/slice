let mu0 = 0.5 in 
let mu1 = 1.0 in
let mu2 = 2.0 in

let Z0 = discrete(0.7, 0.2, 0.1) in

let Z1 =
  if Z0 <#3 1#3 then
    discrete(0.7, 0.2, 0.1)
  else if Z0 <#3 2#3 then
    discrete(0.2, 0.5, 0.3)
  else
    discrete(0.1, 0.1, 0.8)
in

let Z2 =
  if Z1 <#3 1#3 then
    discrete(0.7, 0.2, 0.1)
  else if Z1 <#3 2#3 then
    discrete(0.2, 0.5, 0.3)
  else
    discrete(0.1, 0.1, 0.8)
in

let Z3 =
  if Z2 <#3 1#3 then
    discrete(0.7, 0.2, 0.1)
  else if Z2 <#3 2#3 then
    discrete(0.2, 0.5, 0.3)
  else
    discrete(0.1, 0.1, 0.8)
in

let Y0 =
  if Z0 <#3 1#3 then
    gaussian(mu0, 1)
  else if Z0 <#3 2#3 then
    gaussian(mu1, 1)
  else
    gaussian(mu2, 1)
in

let Y1 =
  if Z1 <#3 1#3 then
    gaussian(mu0, 1)
  else if Z1 <#3 2#3 then
    gaussian(mu1, 1)
  else
    gaussian(mu2, 1)
in

let Y2 =
  if Z2 <#3 1#3 then
    gaussian(mu0, 1)
  else if Z2 <#3 2#3 then
    gaussian(mu1, 1)
  else
    gaussian(mu2, 1)
in

let Y3 =
  if Z3 <#3 1#3 then
    gaussian(mu0, 1)
  else if Z3 <#3 2#3 then
    gaussian(mu1, 1)
  else
    gaussian(mu2, 1)
in

Y3 < 0.5
