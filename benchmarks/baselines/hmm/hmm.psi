def main() {
    n := 100;
    X := array(n);
    Y := array(n);
    Z := array(n);

    seperated := bernoulli(0.4);

    if seperated == 0 {
        Z[0] = bernoulli(0.5);
        if Z[0] == 0 {
            X[0] = gauss(5, 1);
            Y[0] = poisson(5);
        } else {
            X[0] = gauss(7, 1);
            Y[0] = poisson(8);
        }

        for i in [1..n) {
            if Z[i - 1] == 0 {
                Z[i] = bernoulli(0.2);
            } else {
                Z[i] = bernoulli(0.8);
            }

            if Z[i] == 0 {
                X[i] = gauss(5, 1);
                Y[i] = poisson(5);
            } else {
                X[i] = gauss(7, 1);
                Y[i] = poisson(8);
            }
        }
    } else {
        Z[0] = bernoulli(0.5);
        if Z[0] == 0 {
            X[0] = gauss(5, 1);
            Y[0] = poisson(3);
        } else {
            X[0] = gauss(15, 1);
            Y[0] = poisson(8);
        }

        for i in [1..n) {
            if Z[i - 1] == 0 {
                Z[i] = bernoulli(0.2);
            } else {
                Z[i] = bernoulli(0.8);
            }

            if Z[i] == 0 {
                X[i] = gauss(5, 1);
                Y[i] = poisson(3);
            } else {
                X[i] = gauss(15, 1);
                Y[i] = poisson(8);
            }
        }
    }

    return Z[0] < 0.5;
}
