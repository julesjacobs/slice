# Exact probability pair for the SurveyUnbias query:
#   observed answer_0 = 1
#   query = not(answer_0)
# Output order is (P(query = false), P(query = true)).

def bucket_prob(i nat) prob:
    nat2prob(i + 1) / 10

evidence = summate i from 0 to 10:
    (1/10) * bucket_prob(i)

(evidence / evidence, nat2prob(0))
