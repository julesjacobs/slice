posterior =
  disint(
    def prob_not(p prob) prob:
        real2prob(1 - prob2real(p))

    def bern(p prob):
        i <~ categorical([p, prob_not(p)])
        return [true, false][i]

    def observe_bool(b bool):
        if b:
            weight(1, return ())
        else:
            weight(0, return ())

    def observe_eq(actual bool, expected bool):
        if expected:
            observe_bool(actual)
        else:
            if actual:
                weight(0, return ())
            else:
                weight(1, return ())

    # Right endpoints of binspace(0, 1, 21), as used for similar[i].
    def binspace20_right(p prob) prob:
        if p <= 1/20:
            1/20
        else:
            if p <= 2/20:
                2/20
            else:
                if p <= 3/20:
                    3/20
                else:
                    if p <= 4/20:
                        4/20
                    else:
                        if p <= 5/20:
                            5/20
                        else:
                            if p <= 6/20:
                                6/20
                            else:
                                if p <= 7/20:
                                    7/20
                                else:
                                    if p <= 8/20:
                                        8/20
                                    else:
                                        if p <= 9/20:
                                            9/20
                                        else:
                                            if p <= 10/20:
                                                10/20
                                            else:
                                                if p <= 11/20:
                                                    11/20
                                                else:
                                                    if p <= 12/20:
                                                        12/20
                                                    else:
                                                        if p <= 13/20:
                                                            13/20
                                                        else:
                                                            if p <= 14/20:
                                                                14/20
                                                            else:
                                                                if p <= 15/20:
                                                                    15/20
                                                                else:
                                                                    if p <= 16/20:
                                                                        16/20
                                                                    else:
                                                                        if p <= 17/20:
                                                                            17/20
                                                                        else:
                                                                            if p <= 18/20:
                                                                                18/20
                                                                            else:
                                                                                if p <= 19/20:
                                                                                    19/20
                                                                                else:
                                                                                    1

    # Right endpoints of binspace(0, 1, 11), as used for click_url_A[i] and click_url_B[i].
    def binspace10_right(p real) prob:
        if p <= 1/10:
            1/10
        else:
            if p <= 2/10:
                2/10
            else:
                if p <= 3/10:
                    3/10
                else:
                    if p <= 4/10:
                        4/10
                    else:
                        if p <= 5/10:
                            5/10
                        else:
                            if p <= 6/10:
                                6/10
                            else:
                                if p <= 7/10:
                                    7/10
                                else:
                                    if p <= 8/10:
                                        8/10
                                    else:
                                        if p <= 9/10:
                                            9/10
                                        else:
                                            1

    def draw_p_click_url_B(is_similar bool, p_click_url_A real):
        if is_similar:
            return p_click_url_A
        else:
            uniform(0, 1)

    p_similar <~ beta(1, 1)

    similar_0 <~ bern(binspace20_right(p_similar))
    similar_1 <~ bern(binspace20_right(p_similar))
    similar_2 <~ bern(binspace20_right(p_similar))
    similar_3 <~ bern(binspace20_right(p_similar))
    similar_4 <~ bern(binspace20_right(p_similar))
    similar = [similar_0, similar_1, similar_2, similar_3, similar_4]

    p_click_url_A_0 <~ uniform(0, 1)
    p_click_url_A_1 <~ uniform(0, 1)
    p_click_url_A_2 <~ uniform(0, 1)
    p_click_url_A_3 <~ uniform(0, 1)
    p_click_url_A_4 <~ uniform(0, 1)
    p_click_url_A = [p_click_url_A_0, p_click_url_A_1, p_click_url_A_2,
                     p_click_url_A_3, p_click_url_A_4]

    p_click_url_B_0 <~ draw_p_click_url_B(similar[0], p_click_url_A[0])
    p_click_url_B_1 <~ draw_p_click_url_B(similar[1], p_click_url_A[1])
    p_click_url_B_2 <~ draw_p_click_url_B(similar[2], p_click_url_A[2])
    p_click_url_B_3 <~ draw_p_click_url_B(similar[3], p_click_url_A[3])
    p_click_url_B_4 <~ draw_p_click_url_B(similar[4], p_click_url_A[4])
    p_click_url_B = [p_click_url_B_0, p_click_url_B_1, p_click_url_B_2,
                     p_click_url_B_3, p_click_url_B_4]

    click_url_A_0 <~ bern(binspace10_right(p_click_url_A[0]))
    click_url_A_1 <~ bern(binspace10_right(p_click_url_A[1]))
    click_url_A_2 <~ bern(binspace10_right(p_click_url_A[2]))
    click_url_A_3 <~ bern(binspace10_right(p_click_url_A[3]))
    click_url_A_4 <~ bern(binspace10_right(p_click_url_A[4]))
    click_url_A = [click_url_A_0, click_url_A_1, click_url_A_2,
                   click_url_A_3, click_url_A_4]

    click_url_B_0 <~ bern(binspace10_right(p_click_url_B[0]))
    click_url_B_1 <~ bern(binspace10_right(p_click_url_B[1]))
    click_url_B_2 <~ bern(binspace10_right(p_click_url_B[2]))
    click_url_B_3 <~ bern(binspace10_right(p_click_url_B[3]))
    click_url_B_4 <~ bern(binspace10_right(p_click_url_B[4]))
    click_url_B = [click_url_B_0, click_url_B_1, click_url_B_2,
                   click_url_B_3, click_url_B_4]


    return (
        ((click_url_A_0, (click_url_A_1, (click_url_A_2, (click_url_A_3, click_url_A_4)))),
         (click_url_B_0, (click_url_B_1, (click_url_B_2, (click_url_B_3, click_url_B_4))))),
        p_similar < 3/10
    )
  )

posterior(((true, (true, (false, (true, false)))), (true, (true, (false, (true, false))))))
