posterior =
  disint(
    def prob_not(p prob) prob:
        real2prob(1 - prob2real(p))

    def bern(p prob):
        i <~ categorical([p, prob_not(p)])
        return [true, false][i]

    def observe_bool(b bool):
        if b:
            weight(1, return ())
        else:
            weight(0, return ())

    def observe_eq(actual bool, expected bool):
        if expected:
            observe_bool(actual)
        else:
            if actual:
                weight(0, return ())
            else:
                weight(1, return ())

    def draw_click_pair(similarityAll prob):
        sim <~ bern(similarityAll)
        beta1 <~ beta(1, 1)
        beta2 <~ if sim:
                     return beta1
                 else:
                     beta(1, 1)
        click0 <~ bern(beta1)
        click1 <~ bern(beta2)
        return (click0, click1)

    clicks_0 = [true, true, true, false, false]
    clicks_1 = [true, true, true, false, false]

    similarityAll <~ beta(1, 1)

    # Loops (e.g. plates in Hakaru) are manually unrolled because Hakaru's normalize command (which is necessary when conditioning) does not support plate.
    clickPair_0 <~ draw_click_pair(similarityAll)
    clickPair_1 <~ draw_click_pair(similarityAll)
    clickPair_2 <~ draw_click_pair(similarityAll)
    clickPair_3 <~ draw_click_pair(similarityAll)
    clickPair_4 <~ draw_click_pair(similarityAll)

    click0_0 = match clickPair_0: (click0, click1): click0
    click0_1 = match clickPair_1: (click0, click1): click0
    click0_2 = match clickPair_2: (click0, click1): click0
    click0_3 = match clickPair_3: (click0, click1): click0
    click0_4 = match clickPair_4: (click0, click1): click0
    click1_0 = match clickPair_0: (click0, click1): click1
    click1_1 = match clickPair_1: (click0, click1): click1
    click1_2 = match clickPair_2: (click0, click1): click1
    click1_3 = match clickPair_3: (click0, click1): click1
    click1_4 = match clickPair_4: (click0, click1): click1

    sim_0 = [click0_0, click0_1, click0_2, click0_3, click0_4]
    sim_1 = [click1_0, click1_1, click1_2, click1_3, click1_4]

    return (
        ((click0_0, (click0_1, (click0_2, (click0_3, click0_4)))),
         (click1_0, (click1_1, (click1_2, (click1_3, click1_4))))),
        similarityAll < 3/10
    )
  )

posterior(((true, (true, (true, (false, false)))),
           (true, (true, (true, (false, false))))))
