# Exact probability pair for the Election query:
#   query = win
# Output order is (P(query = false), P(query = true)).
#
# This is the probability returned by the SPPL baseline after its beta/binomial
# discretization over param in [250, 350).

p_win = 0.3318956304871102

(real2prob(1 - prob2real(p_win)), p_win)
