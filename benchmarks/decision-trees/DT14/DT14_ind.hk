posterior =
  disint(
    # DT14_ind.hk: generated from the paired Slice query.

    def observe_bool(b bool):
        if b:
            weight(1, return ())
        else:
            weight(0, return ())

    sex_f <~ categorical([0.3307, 0.6693])


    age_f <~ normal(38.5816, 186.0614)

    relationship_f <~ categorical([0.0481, 0.1557, 0.4051, 0.2551, 0.0301, 0.1059])


    t_f <~ if relationship_f == 1:
               return 1.0
           else:
               if relationship_f == 2:
                   if age_f < 21.5:
                       return 1.0
                   else:
                       if age_f < 47.5:
                           return 1.0
                       else:
                           return 0.0
               else:
                   if relationship_f == 3:
                       return 1.0
                   else:
                       if relationship_f == 4:
                           if age_f < 50.5:
                               return 1.0
                           else:
                               return 0.0
                       else:
                           if relationship_f == 5:
                               if age_f < 49.5:
                                   return 1.0
                               else:
                                   return 0.0
                           else:
                               return 1.0

    sex_m <~ categorical([0.3307, 0.6693])


    age_m <~ normal(38.5816, 186.0614)

    relationship_m <~ categorical([0.0481, 0.1557, 0.4051, 0.2551, 0.0301, 0.1059])


    t_m <~ if relationship_m == 1:
               return 1.0
           else:
               if relationship_m == 2:
                   if age_m < 21.5:
                       return 1.0
                   else:
                       if age_m < 47.5:
                           return 1.0
                       else:
                           return 0.0
               else:
                   if relationship_m == 3:
                       return 1.0
                   else:
                       if relationship_m == 4:
                           if age_m < 50.5:
                               return 1.0
                           else:
                               return 0.0
                       else:
                           if relationship_m == 5:
                               if age_m < 49.5:
                                   return 1.0
                               else:
                                   return 0.0
                           else:
                               return 1.0

    _ <~ observe_bool(age_f > 18.0)
    _ <~ observe_bool(age_m > 18.0)

    return ((sex_f, sex_m), (t_f >= 1.0, t_m >= 1.0))
  )

posterior((0, 1))
