// DT14_ind.psi: generated from the paired Slice query.
def main() {
    sex_f := categorical([0.3307, 0.6693]);
    observe(sex_f < 1);
    age_f := gauss(38.5816, 186.0614);
    relationship_f := categorical([0.0481, 0.1557, 0.4051, 0.2551, 0.0301, 0.1059]);
    observe(age_f > 18.0);
    t_f := 0;
    if relationship_f == 1 {
        t_f = 1.0;
    } else {
        if relationship_f == 2 {
            if age_f < 21.5 {
                t_f = 1.0;
            } else {
                if age_f < 47.5 {
                    t_f = 1.0;
                } else {
                    t_f = 0.0;
                }
            }
        } else {
            if relationship_f == 3 {
                t_f = 1.0;
            } else {
                if relationship_f == 4 {
                    if age_f < 50.5 {
                        t_f = 1.0;
                    } else {
                        t_f = 0.0;
                    }
                } else {
                    if relationship_f == 5 {
                        if age_f < 49.5 {
                            t_f = 1.0;
                        } else {
                            t_f = 0.0;
                        }
                    } else {
                        t_f = 1.0;
                    }
                }
            }
        }
    }
    sex_m := categorical([0.3307, 0.6693]);
    observe(sex_m >= 1);
    age_m := gauss(38.5816, 186.0614);
    relationship_m := categorical([0.0481, 0.1557, 0.4051, 0.2551, 0.0301, 0.1059]);
    observe(age_m > 18.0);
    t_m := 0;
    if relationship_m == 1 {
        t_m = 1.0;
    } else {
        if relationship_m == 2 {
            if age_m < 21.5 {
                t_m = 1.0;
            } else {
                if age_m < 47.5 {
                    t_m = 1.0;
                } else {
                    t_m = 0.0;
                }
            }
        } else {
            if relationship_m == 3 {
                t_m = 1.0;
            } else {
                if relationship_m == 4 {
                    if age_m < 50.5 {
                        t_m = 1.0;
                    } else {
                        t_m = 0.0;
                    }
                } else {
                    if relationship_m == 5 {
                        if age_m < 49.5 {
                            t_m = 1.0;
                        } else {
                            t_m = 0.0;
                        }
                    } else {
                        t_m = 1.0;
                    }
                }
            }
        }
    }
    return (t_f >= 1.0, t_m >= 1.0);
}
