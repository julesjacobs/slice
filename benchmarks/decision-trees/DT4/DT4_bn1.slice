let sex_f = discrete(0.3307, 0.6693) in
let _1 = observe(sex_f <#2 1#2) in

let capital_gain_f =
  gaussian(568.4105, 24248365.5428) in

let age_f =
  if capital_gain_f < 7298.0 then
    gaussian(38.4208, 184.9151)
  else
    gaussian(38.8125, 193.4918) in

let _2 = observe(age_f > 18.0) in

let t_f =
  if capital_gain_f >= 7073.5 then
    if age_f < 20.0 then 1.0 else 0.0
  else
    1.0
in

let sex_m = discrete(0.3307, 0.6693) in
let _3 = observe(sex_m >=#2 1#2) in

let capital_gain_m =
  gaussian(1329.3700, 69327473.1006) in

let age_m =
  if capital_gain_m < 5178.0 then
    gaussian(38.6361, 187.2435)
  else
    gaussian(38.2668, 187.2747) in

let _4 = observe(age_m > 18.0) in

let t_m =
  if capital_gain_m >= 7073.5 then
    if age_m < 20.0 then 1.0 else 0.0
  else
    1.0
in

(t_f >= 1.0, t_m >= 1.0)
