// DT4_bn1.psi: generated from the paired Slice query.
def main() {
    sex_f := categorical([0.3307, 0.6693]);
    observe(sex_f < 1);
    capital_gain_f := gauss(568.4105, 24248365.5428);
    age_f := 0;
    if capital_gain_f < 7298.0 {
        age_f = gauss(38.4208, 184.9151);
    } else {
        age_f = gauss(38.8125, 193.4918);
    }
    observe(age_f > 18.0);
    t_f := 0;
    if capital_gain_f >= 7073.5 {
        if age_f < 20.0 {
            t_f = 1.0;
        } else {
            t_f = 0.0;
        }
    } else {
        t_f = 1.0;
    }
    sex_m := categorical([0.3307, 0.6693]);
    observe(sex_m >= 1);
    capital_gain_m := gauss(1329.3700, 69327473.1006);
    age_m := 0;
    if capital_gain_m < 5178.0 {
        age_m = gauss(38.6361, 187.2435);
    } else {
        age_m = gauss(38.2668, 187.2747);
    }
    observe(age_m > 18.0);
    t_m := 0;
    if capital_gain_m >= 7073.5 {
        if age_m < 20.0 {
            t_m = 1.0;
        } else {
            t_m = 0.0;
        }
    } else {
        t_m = 1.0;
    }
    return (t_f >= 1.0, t_m >= 1.0);
}
