posterior =
  disint(
    # DT4_ind.hk: generated from the paired Slice query.

    def observe_bool(b bool):
        if b:
            weight(1, return ())
        else:
            weight(0, return ())

    sex_f <~ categorical([0.3307, 0.6693])


    age_f <~ normal(38.5816, 186.0614)

    capital_gain_f <~ normal(1077.6488, 54542539.1784)


    t_f <~ if capital_gain_f >= 7073.5:
               if age_f < 20.0:
                   return 1.0
               else:
                   return 0.0
           else:
               return 1.0

    sex_m <~ categorical([0.3307, 0.6693])


    age_m <~ normal(38.5816, 186.0614)

    capital_gain_m <~ normal(1077.6488, 54542539.1784)


    t_m <~ if capital_gain_m >= 7073.5:
               if age_m < 20.0:
                   return 1.0
               else:
                   return 0.0
           else:
               return 1.0

    _ <~ observe_bool(age_f > 18.0)
    _ <~ observe_bool(age_m > 18.0)

    return ((sex_f, sex_m), (t_f >= 1.0, t_m >= 1.0))
  )

posterior((0, 1))
