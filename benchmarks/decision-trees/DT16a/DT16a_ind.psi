// DT16a_ind.psi: generated by duplicating the single Slice query into female/male conditioned copies.
def main() {
    relationship_f := categorical([0.0481, 0.1557, 0.4051, 0.2551, 0.0301, 0.1059]);
    sex_f := categorical([0.3307, 0.6693]);
    observe(sex_f < 1);
    capital_gain_f := gauss(1077.6488, 54542539.1784);
    t_initial_f := 0;
    if relationship_f == 0 {
        if capital_gain_f < 5095.5 {
            t_initial_f = 1.0;
        } else {
            t_initial_f = 0.0;
        }
    } else {
        if relationship_f == 1 {
            if capital_gain_f < 4718.5 {
                t_initial_f = 1.0;
            } else {
                t_initial_f = 0.0;
            }
        } else {
            if relationship_f == 2 {
                if capital_gain_f < 5095.5 {
                    t_initial_f = 1.0;
                } else {
                    t_initial_f = 0.0;
                }
            } else {
                if relationship_f == 3 {
                    if capital_gain_f < 8296.0 {
                        t_initial_f = 1.0;
                    } else {
                        t_initial_f = 0.0;
                    }
                } else {
                    if relationship_f == 4 {
                        t_initial_f = 1.0;
                    } else {
                        if capital_gain_f < 4668.5 {
                            t_initial_f = 1.0;
                        } else {
                            t_initial_f = 0.0;
                        }
                    }
                }
            }
        }
    }
    fl_f := 0;
    if t_initial_f > 0.5 && sex_f < 1 {
        fl_f = categorical([0.15, 0.85]);
    } else {
        fl_f = categorical([1.0, 0.0]);
    }
    t_f := 0;
    if t_initial_f > 0.5 && sex_f < 1 {
        if fl_f < 1 {
            t_f = 0.0;
        } else {
            t_f = t_initial_f;
        }
    } else {
        t_f = t_initial_f;
    }
    relationship_m := categorical([0.0481, 0.1557, 0.4051, 0.2551, 0.0301, 0.1059]);
    sex_m := categorical([0.3307, 0.6693]);
    observe(sex_m >= 1);
    capital_gain_m := gauss(1077.6488, 54542539.1784);
    t_initial_m := 0;
    if relationship_m == 0 {
        if capital_gain_m < 5095.5 {
            t_initial_m = 1.0;
        } else {
            t_initial_m = 0.0;
        }
    } else {
        if relationship_m == 1 {
            if capital_gain_m < 4718.5 {
                t_initial_m = 1.0;
            } else {
                t_initial_m = 0.0;
            }
        } else {
            if relationship_m == 2 {
                if capital_gain_m < 5095.5 {
                    t_initial_m = 1.0;
                } else {
                    t_initial_m = 0.0;
                }
            } else {
                if relationship_m == 3 {
                    if capital_gain_m < 8296.0 {
                        t_initial_m = 1.0;
                    } else {
                        t_initial_m = 0.0;
                    }
                } else {
                    if relationship_m == 4 {
                        t_initial_m = 1.0;
                    } else {
                        if capital_gain_m < 4668.5 {
                            t_initial_m = 1.0;
                        } else {
                            t_initial_m = 0.0;
                        }
                    }
                }
            }
        }
    }
    fl_m := 0;
    if t_initial_m > 0.5 && sex_m < 1 {
        fl_m = categorical([0.15, 0.85]);
    } else {
        fl_m = categorical([1.0, 0.0]);
    }
    t_m := 0;
    if t_initial_m > 0.5 && sex_m < 1 {
        if fl_m < 1 {
            t_m = 0.0;
        } else {
            t_m = t_initial_m;
        }
    } else {
        t_m = t_initial_m;
    }
    return (t_f >= 1.0, t_m >= 1.0);
}
