# DT16a_bn2.hk: generated by duplicating the single Slice query into female/male conditioned copies.

def observe_bool(b bool):
    if b:
        weight(1, return ())
    else:
        weight(0, return ())

sex_f <~ categorical([0.3307, 0.6693])

_ <~ observe_bool(sex_f < 1)

capital_gain_f <~ if sex_f < 1:
                      normal(568.4105, 24248365.5428)
                  else:
                      normal(1329.3700, 69327473.1006)

age_f <~ if sex_f < 1:
             if capital_gain_f < 7298.0:
                 normal(38.4208, 184.9151)
             else:
                 normal(38.8125, 193.4918)
         else:
             if capital_gain_f < 5178.0:
                 normal(38.6361, 187.2435)
             else:
                 normal(38.2668, 187.2747)

education_num_f <~ if sex_f < 1:
                       if capital_gain_f < 7298.0:
                           normal(10.0827, 6.5096)
                       else:
                           normal(10.1041, 6.1522)
                   else:
                       if capital_gain_f < 5178.0:
                           normal(10.0817, 6.4841)
                       else:
                           normal(10.0974, 7.1793)

relationship_f <~ if sex_f < 1:
                      if capital_gain_f < 7298.0:
                          categorical([0.0491, 0.1556, 0.4012, 0.2589, 0.0294, 0.1058])
                      else:
                          categorical([0.0416, 0.1667, 0.4583, 0.2292, 0.0166, 0.0876])
                  else:
                      if capital_gain_f < 5178.0:
                          categorical([0.0497, 0.1545, 0.4021, 0.2590, 0.0294, 0.1053])
                      else:
                          categorical([0.0417, 0.1624, 0.3976, 0.2606, 0.0356, 0.1021])

_ <~ observe_bool(age_f > 18.0)

t_initial_f <~ if relationship_f == 0:
                   if capital_gain_f < 5095.5:
                       return 1.0
                   else:
                       return 0.0
               else:
                   if relationship_f == 1:
                       if capital_gain_f < 4718.5:
                           return 1.0
                       else:
                           return 0.0
                   else:
                       if relationship_f == 2:
                           if capital_gain_f < 5095.5:
                               return 1.0
                           else:
                               return 0.0
                       else:
                           if relationship_f == 3:
                               if capital_gain_f < 8296.0:
                                   return 1.0
                               else:
                                   return 0.0
                           else:
                               if relationship_f == 4:
                                   return 1.0
                               else:
                                   if capital_gain_f < 4668.5:
                                       return 1.0
                                   else:
                                       return 0.0

fl_f <~ if t_initial_f > 0.5 && sex_f < 1:
            categorical([0.15, 0.85])
        else:
            categorical([1.0, 0.0])

t_f <~ if t_initial_f > 0.5 && sex_f < 1:
           if fl_f < 1:
               return 0.0
           else:
               return t_initial_f
       else:
           return t_initial_f

sex_m <~ categorical([0.3307, 0.6693])

_ <~ observe_bool(sex_m >= 1)

capital_gain_m <~ if sex_m < 1:
                      normal(568.4105, 24248365.5428)
                  else:
                      normal(1329.3700, 69327473.1006)

age_m <~ if sex_m < 1:
             if capital_gain_m < 7298.0:
                 normal(38.4208, 184.9151)
             else:
                 normal(38.8125, 193.4918)
         else:
             if capital_gain_m < 5178.0:
                 normal(38.6361, 187.2435)
             else:
                 normal(38.2668, 187.2747)

education_num_m <~ if sex_m < 1:
                       if capital_gain_m < 7298.0:
                           normal(10.0827, 6.5096)
                       else:
                           normal(10.1041, 6.1522)
                   else:
                       if capital_gain_m < 5178.0:
                           normal(10.0817, 6.4841)
                       else:
                           normal(10.0974, 7.1793)

relationship_m <~ if sex_m < 1:
                      if capital_gain_m < 7298.0:
                          categorical([0.0491, 0.1556, 0.4012, 0.2589, 0.0294, 0.1058])
                      else:
                          categorical([0.0416, 0.1667, 0.4583, 0.2292, 0.0166, 0.0876])
                  else:
                      if capital_gain_m < 5178.0:
                          categorical([0.0497, 0.1545, 0.4021, 0.2590, 0.0294, 0.1053])
                      else:
                          categorical([0.0417, 0.1624, 0.3976, 0.2606, 0.0356, 0.1021])

_ <~ observe_bool(age_m > 18.0)

t_initial_m <~ if relationship_m == 0:
                   if capital_gain_m < 5095.5:
                       return 1.0
                   else:
                       return 0.0
               else:
                   if relationship_m == 1:
                       if capital_gain_m < 4718.5:
                           return 1.0
                       else:
                           return 0.0
                   else:
                       if relationship_m == 2:
                           if capital_gain_m < 5095.5:
                               return 1.0
                           else:
                               return 0.0
                       else:
                           if relationship_m == 3:
                               if capital_gain_m < 8296.0:
                                   return 1.0
                               else:
                                   return 0.0
                           else:
                               if relationship_m == 4:
                                   return 1.0
                               else:
                                   if capital_gain_m < 4668.5:
                                       return 1.0
                                   else:
                                       return 0.0

fl_m <~ if t_initial_m > 0.5 && sex_m < 1:
            categorical([0.15, 0.85])
        else:
            categorical([1.0, 0.0])

t_m <~ if t_initial_m > 0.5 && sex_m < 1:
           if fl_m < 1:
               return 0.0
           else:
               return t_initial_m
       else:
           return t_initial_m

return (t_f < 0.5, t_m < 0.5)
