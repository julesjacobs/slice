posterior =
  disint(
    # DT16a_ind.hk: generated by duplicating the single Slice query into female/male conditioned copies.

    def observe_bool(b bool):
        if b:
            weight(1, return ())
        else:
            weight(0, return ())

    relationship_f <~ categorical([0.0481, 0.1557, 0.4051, 0.2551, 0.0301, 0.1059])

    sex_f <~ categorical([0.3307, 0.6693])


    capital_gain_f <~ normal(1077.6488, 54542539.1784)

    t_initial_f <~ if relationship_f == 0:
                       if capital_gain_f < 5095.5:
                           return 1.0
                       else:
                           return 0.0
                   else:
                       if relationship_f == 1:
                           if capital_gain_f < 4718.5:
                               return 1.0
                           else:
                               return 0.0
                       else:
                           if relationship_f == 2:
                               if capital_gain_f < 5095.5:
                                   return 1.0
                               else:
                                   return 0.0
                           else:
                               if relationship_f == 3:
                                   if capital_gain_f < 8296.0:
                                       return 1.0
                                   else:
                                       return 0.0
                               else:
                                   if relationship_f == 4:
                                       return 1.0
                                   else:
                                       if capital_gain_f < 4668.5:
                                           return 1.0
                                       else:
                                           return 0.0

    fl_f <~ if t_initial_f > 0.5 && sex_f < 1:
                categorical([0.15, 0.85])
            else:
                categorical([1.0, 0.0])

    t_f <~ if t_initial_f > 0.5 && sex_f < 1:
               if fl_f < 1:
                   return 0.0
               else:
                   return t_initial_f
           else:
               return t_initial_f

    relationship_m <~ categorical([0.0481, 0.1557, 0.4051, 0.2551, 0.0301, 0.1059])

    sex_m <~ categorical([0.3307, 0.6693])


    capital_gain_m <~ normal(1077.6488, 54542539.1784)

    t_initial_m <~ if relationship_m == 0:
                       if capital_gain_m < 5095.5:
                           return 1.0
                       else:
                           return 0.0
                   else:
                       if relationship_m == 1:
                           if capital_gain_m < 4718.5:
                               return 1.0
                           else:
                               return 0.0
                       else:
                           if relationship_m == 2:
                               if capital_gain_m < 5095.5:
                                   return 1.0
                               else:
                                   return 0.0
                           else:
                               if relationship_m == 3:
                                   if capital_gain_m < 8296.0:
                                       return 1.0
                                   else:
                                       return 0.0
                               else:
                                   if relationship_m == 4:
                                       return 1.0
                                   else:
                                       if capital_gain_m < 4668.5:
                                           return 1.0
                                       else:
                                           return 0.0

    fl_m <~ if t_initial_m > 0.5 && sex_m < 1:
                categorical([0.15, 0.85])
            else:
                categorical([1.0, 0.0])

    t_m <~ if t_initial_m > 0.5 && sex_m < 1:
               if fl_m < 1:
                   return 0.0
               else:
                   return t_initial_m
           else:
               return t_initial_m

    return ((sex_f, sex_m), (t_f >= 1.0, t_m >= 1.0))
  )

posterior((0, 1))
