exact fn trans (s) {
  if s then flip(0.25) else flip(0.125)
}

sample fn obs (s) {
  if s then ~uniform(0.0, 6.0) else ~uniform(0.0, 8.0)
}

sample fn hmm (n : Int) {
    ix <- 0;
    states <- [true];
    observations <- [];
    while ix < n {
        newState <- exact(trans(states[ix]));
        newObs <- obs(newState);
        states <- push(states, newState);
        observations <- push(observations, newObs);
        ix <- ix + 1;
        true
    };
    observations
}

sample {
    hmm(10)
}