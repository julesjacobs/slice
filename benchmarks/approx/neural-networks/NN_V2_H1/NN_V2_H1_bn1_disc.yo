exact fn capital_gain() {
    let sex = discrete(0.33070,0.6693) in 
    let capital_gain = if sex < 1 then
      discrete(0.500076, 0.0000311854, 0.00000369355, 0.499889)
    else
      discrete(0.500022, 0.0000109076, 0.00000129188, 0.499966) in
    capital_gain
}

sample {
    capital_gain <- exact(capital_gain());
    
    age <- if sex < 1 then 
        if capital_gain < 3 then 
            ~normal(38.4208, 184.9151)
        else
            ~normal(38.8125, 193.4918)
        else
        if capital_gain < 1 then 
            ~normal(38.6361, 187.2435)
        else
            ~normal(38.2668, 187.2747);
    
    education_num <- if sex < 1 then 
        if capital_gain < 3 then 
            ~normal(10.0827, 6.5096)
        else
            ~normal(10.1041, 6.1522)
        else
        if capital_gain < 1 then 
            ~normal(10.0817, 6.4841)
        else
            ~normal(10.0974, 7.1793);

    N_age <- ((age - 17.0) / 73.0  - 0.5) * 10 + 0.5;
    N_education_num <- ((education_num - 3.0) / 13.0  - 0.5) * 10 + 0.5;
    h1 <- 0.1718 * N_age +  1.1416 * N_education_num +  0.4754;
    h1 <- if h1 < 0 then 0 else 0.1718 * N_age +  1.1416 * N_education_num +  0.4754;
    o1 <- 0.4778 * h1 +  1.2091;
    o1 <- if o1 < 0 then 0 else 0.4778 * h1 +  1.2091;
    o2 <- 1.9717 * h1 + -0.3104;
    o2 <- if o2 < 0 then 0 else 1.9717 * h1 + -0.3104;
    o1 < o2
}