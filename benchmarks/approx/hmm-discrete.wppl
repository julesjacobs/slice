// Function to compute average score 
var calculateAverageScore = function(output) {
  var scores = map(function(sample) { return sample.score; }, output.samples);
  var sum = reduce(function(total, score) { return total + score; }, 0, scores);
  return sum / output.samples.length;
};


// Actual HMM logic
var transition = function(s) {
  // Transition using a manually constructed bimodal distribution
  var u = flip(0.5);
  return s 
    ? (u ? flip(0.005) : flip(0.0025)) // Bimodal: Two separate Gaussians
    : (u ? flip(0.0025) : flip(0.00125)); // Another bimodal setup
};

var observe = function(s) {
  return s ? flip(0.25) : flip(0.125);
};

var hmm = function(n, total_steps) {
  var prev = (n == 1) ? {states: [true], observations: []} : hmm(n - 1, total_steps);
  
  if (n == total_steps) {
    // Append a single final state and observation at the end
    var s = prev.states[prev.states.length - 1];
    var finalState = s ? uniform(0,100) : uniform(0,200);
    var finalObs = s ? uniform(0,100) : uniform(0,150);
    return {
      states: prev.states.concat([finalState]),
      observations: prev.observations.concat([finalObs])
    };
  } else {
    // Build the sequence for n steps
    var newState = transition(prev.states[prev.states.length - 1]);
    var newObs = observe(newState);
    return {
        states: prev.states.concat([newState]),
        observations: prev.observations.concat([newObs])
    };
  }
};

var model = function() {
  var r = hmm(5, 5); // HMM with n time steps
  return r.states;
};

// Example usage
var smcOutput = Infer({method: 'SMC', particles: 1000, model: model});

// Compute and print the average score
console.log(smcOutput);
var avgScore = calculateAverageScore(smcOutput);
console.log("Average Score:", avgScore);

