(* Random interval-covering over [0,1].

  The program keeps sampling points until it random decides to stop (hence an unbounded loop),
  then checks whether if by stopping time has covered every part of the interval [0,1]. *)


(* Returns true if lo <= y < hi *)
let within = fun lo -> fun hi -> fun y ->
    (y >= lo) && (y < hi)
in 

(* Function for sampling interval bounds *)
let b = fun _ -> discrete(0.18: 0.05, 0.11: 0.24, 0.21: 0.37, 0.09: 0.58, 0.41: 0.89) in

(* Initialize intervals by sampling their respective (possibly overlapping) bounds *)
let init =
  (false, within 0.00 (b ())) ::
  (false, within (b ()) (b ())) ::
  (false, within (b ()) (b ())) ::
  (false, within (b ()) 1.00) ::
  nil
in 

(* Update flags depending on y falling within the respective interval *)
let update = fix update y := fun ys -> 
    match ys with 
    | nil -> nil
    | h :: t -> ((fst h || ((snd h) y)), snd h) :: (update y t)
    end
in 

(* Sample from a gaussian, then use so-obtained value to update flags *)
let step = fun ys -> update (gaussian(0,1)) ys
in

(* Number of samples determined by unbounded recursion *)
let cover = fix cover st :=
  if uniform(0,1) < 0.1 then st 
  else 
    cover (step st)
in

(* Have all intervals been covered at least once? *)
let is_covered = fix is_covered ys :=
    match ys with 
    | nil -> true 
    | h :: t -> (fst h) && (is_covered t)
    end
in 

(* Query if we covered the whole interval *)
let final = cover init in
is_covered final
